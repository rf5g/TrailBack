<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark">

    <!-- Контейнер карты: сюда подключается org.mapsforge MapView программно,
         либо отображается серая заглушка при отсутствии офлайн-карт и интернета -->
    <FrameLayout
        android:id="@+id/mapContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/topInfoPanel"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <include
        android:id="@+id/topInfoPanel"
        layout="@layout/view_top_info_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Левый край: мини-компас сверху -->
    <com.trailback.app.ui.compass.MiniCompassView
        android:id="@+id/miniCompassView"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_margin="12dp"
        android:background="@drawable/bg_circle_panel"
        app:layout_constraintTop_toBottomOf="@id/topInfoPanel"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Верхний правый угол: меню и отмеченные места (быстрая отметка), друг под другом.
         Вся правая колонка (меню/отметка/зум/центрирование) собрана в
         настоящую constraint-цепочку с гибкими распорками между группами —
         это гарантирует отсутствие наложений кнопок на любом размере экрана
         (в отличие от независимых vertical_bias у каждой кнопки по
         отдельности, которые считались относительно ВСЕГО экрана, не учитывая
         фактическое положение соседних кнопок). -->
    <ImageButton
        android:id="@+id/menuButton"
        style="@style/SquareIconButton"
        android:src="@drawable/ic_menu"
        app:layout_constraintVertical_chainStyle="spread_inside"
        app:layout_constraintTop_toBottomOf="@id/topInfoPanel"
        app:layout_constraintBottom_toTopOf="@id/quickMarkButton"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageButton
        android:id="@+id/quickMarkButton"
        style="@style/SquareIconButton"
        android:src="@drawable/ic_flag"
        app:layout_constraintTop_toBottomOf="@id/menuButton"
        app:layout_constraintBottom_toTopOf="@id/topButtonSpacer"
        app:layout_constraintEnd_toEndOf="parent" />

    <View
        android:id="@+id/topButtonSpacer"
        android:layout_width="1dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/quickMarkButton"
        app:layout_constraintBottom_toTopOf="@id/zoomInButton"
        app:layout_constraintVertical_weight="1"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageButton
        android:id="@+id/zoomInButton"
        style="@style/SquareIconButton"
        android:src="@drawable/ic_zoom_in"
        app:layout_constraintTop_toBottomOf="@id/topButtonSpacer"
        app:layout_constraintBottom_toTopOf="@id/zoomOutButton"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageButton
        android:id="@+id/zoomOutButton"
        style="@style/SquareIconButton"
        android:src="@drawable/ic_zoom_out"
        app:layout_constraintTop_toBottomOf="@id/zoomInButton"
        app:layout_constraintBottom_toTopOf="@id/bottomButtonSpacer"
        app:layout_constraintEnd_toEndOf="parent" />

    <View
        android:id="@+id/bottomButtonSpacer"
        android:layout_width="1dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/zoomOutButton"
        app:layout_constraintBottom_toTopOf="@id/recenterButton"
        app:layout_constraintVertical_weight="1"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Кнопка центрирования: замыкает цепочку сверху главной кнопки -->
    <ImageButton
        android:id="@+id/recenterButton"
        style="@style/SquareIconButton"
        android:src="@drawable/ic_recenter"
        app:layout_constraintTop_toBottomOf="@id/bottomButtonSpacer"
        app:layout_constraintBottom_toTopOf="@id/mainActionButton"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Главная кнопка — теперь включает и роль "Я на месте" в режиме "Домой" -->
    <Button
        android:id="@+id/mainActionButton"
        style="@style/MainActionButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="24dp"
        android:text="@string/button_start"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
