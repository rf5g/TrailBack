<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark">

    <!-- Контейнер карты: сюда подключается org.mapsforge MapView программно,
         либо отображается серая заглушка при отсутствии офлайн-карт и интернета -->
    <FrameLayout
        android:id="@+id/mapContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/topInfoPanel"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <include
        android:id="@+id/topInfoPanel"
        layout="@layout/view_top_info_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Левый край: мини-компас сверху -->
    <com.trailback.app.ui.compass.MiniCompassView
        android:id="@+id/miniCompassView"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_margin="12dp"
        android:background="@drawable/bg_circle_panel"
        app:layout_constraintTop_toBottomOf="@id/topInfoPanel"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Правый край, сверху вниз: меню, масштаб, обновить геолокацию, быстрая отметка -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_margin="12dp"
        app:layout_constraintTop_toBottomOf="@id/topInfoPanel"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/menuButton"
            style="@style/RightEdgeIconButton"
            android:src="@drawable/ic_menu" />

        <ImageButton
            android:id="@+id/zoomInButton"
            style="@style/RightEdgeIconButton"
            android:src="@drawable/ic_zoom_in" />

        <ImageButton
            android:id="@+id/zoomOutButton"
            style="@style/RightEdgeIconButton"
            android:src="@drawable/ic_zoom_out" />

        <ImageButton
            android:id="@+id/recenterButton"
            style="@style/RightEdgeIconButton"
            android:src="@drawable/ic_recenter" />

        <ImageButton
            android:id="@+id/quickMarkButton"
            style="@style/RightEdgeIconButton"
            android:src="@drawable/ic_flag" />
    </LinearLayout>

    <!-- Ручная кнопка "Я на месте" — видима только в режиме "Домой" -->
    <Button
        android:id="@+id/manualArrivalButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/manual_arrival_button"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/mainActionButton"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_margin="16dp" />

    <!-- Главная кнопка -->
    <Button
        android:id="@+id/mainActionButton"
        style="@style/MainActionButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="24dp"
        android:text="@string/button_start"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
