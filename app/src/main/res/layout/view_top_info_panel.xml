<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/background_dark"
    android:padding="8dp">

    <!-- Ретро-навигаторский стиль: два бокса с подписью сверху и крупной
         цифрой снизу, разделённые вертикальной линией — по референсу. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/info_panel_bg"
        android:paddingTop="6dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_route_counter"
                android:textColor="@color/info_panel_label"
                android:textSize="13sp"
                android:letterSpacing="0.02" />

            <TextView
                android:id="@+id/distanceTraveledText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/counter_blue"
                android:textSize="34sp"
                android:textStyle="bold"
                tools:text="0ᵐ" />
        </LinearLayout>

        <View
            android:layout_width="1.5dp"
            android:layout_height="match_parent"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="2dp"
            android:background="@color/info_panel_border" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_distance_to_destination"
                android:textColor="@color/info_panel_label"
                android:textSize="13sp"
                android:letterSpacing="0.02" />

            <TextView
                android:id="@+id/distanceToHomeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/counter_destination_brown"
                android:textSize="34sp"
                android:textStyle="bold"
                tools:text="19ᵐ" />
        </LinearLayout>

    </LinearLayout>

    <TextView
        android:id="@+id/satellitesText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:textColor="@color/text_gray"
        android:textSize="13sp"
        tools:text="Спутники GPS: 20   ГЛОНАСС: 12" />

</LinearLayout>
