<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">
        <!-- Настройки компаса -->
        <LinearLayout
            android:id="@+id/compassSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/northModeSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_white" />
        </LinearLayout>
        <!-- Офлайн-карты -->
        <LinearLayout
            android:id="@+id/mapsSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView
                android:id="@+id/mapsFolderText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_gray"
                android:layout_marginBottom="12dp" />
            <Button
                android:id="@+id/chooseMapsFolderButton"
                style="@style/MainActionButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/menu_offline_maps" />
        </LinearLayout>
        <!-- Калибровка -->
        <LinearLayout
            android:id="@+id/calibrationSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView
                android:id="@+id/calibrationTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_white"
                android:textSize="18sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/calibrationText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/text_gray" />
        </LinearLayout>
        <!-- О приложении -->
        <LinearLayout
            android:id="@+id/infoSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="@color/text_white"
                android:textSize="22sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/app_tagline"
                android:textColor="@color/accent_orange"
                android:textSize="14sp"
                android:layout_marginBottom="12dp" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/about_intro"
                android:textColor="@color/text_gray"
                android:textSize="15sp"
                android:lineSpacingExtra="2dp"
                android:layout_marginBottom="16dp" />
            <!-- Офлайн-карты -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_info_card"
                android:padding="16dp"
                android:layout_marginBottom="12dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/about_maps_title"
                    android:textColor="@color/text_white"
                    android:textSize="17sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/about_maps_body"
                    android:textColor="@color/text_gray"
                    android:textSize="14sp"
                    android:lineSpacingExtra="2dp"
                    android:layout_marginTop="6dp" />
            </LinearLayout>
            <!-- Три режима работы -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_info_card"
                android:padding="16dp"
                android:layout_marginBottom="12dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/about_modes_title"
                    android:textColor="@color/text_white"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="10dp" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/about_mode_start_title"
                    android:textColor="@color/accent_orange"
                    android:textSize="15sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/about_mode_start_body"
                    android:textColor="@color/text_gray"
                    android:textSize="14sp"
                    android:lineSpacingExtra="2dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="12dp" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/about_mode_home_title"
                    android:textColor="@color/accent_orange"
                    android:textSize="15sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/about_mode_home_body"
                    android:textColor="@color/text_gray"
                    android:textSize="14sp"
                    android:lineSpacingExtra="2dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="12dp" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/about_mode_arrived_title"
                    android:textColor="@color/accent_orange"
                    android:textSize="15sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/about_mode_arrived_body"
                    android:textColor="@color/text_gray"
                    android:textSize="14sp"
                    android:lineSpacingExtra="2dp"
                    android:layout_marginTop="4dp" />
            </LinearLayout>
            <!-- Компас -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_info_card"
                android:padding="16dp"
                android:layout_marginBottom="12dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/about_compass_title"
                    android:textColor="@color/text_white"
                    android:textSize="17sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/about_compass_body"
                    android:textColor="@color/text_gray"
                    android:textSize="14sp"
                    android:lineSpacingExtra="2dp"
                    android:layout_marginTop="6dp" />
            </LinearLayout>
            <!-- Предупреждение — выделено обводкой акцентного цвета -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_warning_card"
                android:padding="16dp"
                android:layout_marginBottom="12dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/about_warning_title"
                    android:textColor="@color/accent_orange"
                    android:textSize="17sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/about_warning_body"
                    android:textColor="@color/text_white"
                    android:textSize="14sp"
                    android:lineSpacingExtra="2dp"
                    android:layout_marginTop="6dp" />
            </LinearLayout>
            <!-- Совет по калибровке -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_info_card"
                android:padding="16dp"
                android:layout_marginBottom="16dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/about_calibration_tip_title"
                    android:textColor="@color/text_white"
                    android:textSize="17sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/about_calibration_tip_body"
                    android:textColor="@color/text_gray"
                    android:textSize="14sp"
                    android:lineSpacingExtra="2dp"
                    android:layout_marginTop="6dp" />
            </LinearLayout>
            <TextView
                android:id="@+id/versionText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="@color/text_gray"
                android:textSize="12sp"
                tools:text="v1.0.0" />
        </LinearLayout>
        <!-- Язык -->
        <LinearLayout
            android:id="@+id/languageSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <RadioGroup
                android:id="@+id/languageRadioGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <RadioButton
                    android:id="@+id/languageRu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Русский"
                    android:textColor="@color/text_white" />
                <RadioButton
                    android:id="@+id/languageEn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="English"
                    android:textColor="@color/text_white" />
            </RadioGroup>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
